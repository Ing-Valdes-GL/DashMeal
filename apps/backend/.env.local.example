# Serveur
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://

# Supabase (service_role — NE JAMAIS exposer côté client)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT (générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JWT_SECRET=<min-32-chars-secret>
JWT_REFRESH_SECRET=<min-32-chars-secret-different>

# Africa's Talking (SMS / OTP) — https://africastalking.com
AT_API_KEY=atsk_...
AT_USERNAME=sandbox
AT_SENDER_ID=

# Campay (Mobile Money CEMAC) — https://campay.net
CAMPAY_APP_USERNAME=<campay-username>
CAMPAY_APP_PASSWORD=<campay-password>
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_CALLBACK_URL=https://<ton-domaine>/api/v1/payments/webhook/campay
CAMPAY_WEBHOOK_SECRET=<secret-aleatoire-min-16-chars>

# Google Maps — https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=AIza...

# Resend (emails OTP) — https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@tondomaine.com

# Expo Push Notifications — https://expo.dev/accounts
EXPO_ACCESS_TOKEN=<expo-access-token>

# Supabase Storage (bucket names — créer dans le dashboard Supabase)
STORAGE_BUCKET_PRODUCTS=product-images
STORAGE_BUCKET_DOCUMENTS=brand-documents
STORAGE_BUCKET_INVOICES=invoices
STORAGE_BUCKET_ADS=ad-images

# Flags développement
OTP_EXPOSE_CODE=true
OTP_LOG_CODES=true
